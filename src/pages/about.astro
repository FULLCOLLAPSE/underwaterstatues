---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionLabel from '../components/SectionLabel.astro';

// Text comes from content/about.md — edit that file, not this one.
const about = await getEntry('pages', 'about');
if (!about) throw new Error('content/about.md is missing');
const { Content } = await render(about);
---
<Base title="About" description="Underwater Statues makes mounting hardware for camera rigs.">
  <SectionLabel text="About" />
  <div class="rule"></div>
  <article class="prose">
    <h1>{about.data.title}</h1>
    <Content />
  </article>
</Base>
