---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import JournalRow from '../../components/JournalRow.astro';

const entries = (await getCollection('journal', (e) => !e.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Base title="Journal" description="Notes on designing and making camera-rig hardware.">
  <SectionLabel text="Journal" tight />
  <section class="rows">
    <div class="rule"></div>
    {entries.map((e) => <JournalRow href={`/journal/${e.id}`} date={e.data.date} title={e.data.title} />)}
    {entries.length === 0 && <p class="cap" style="padding:20px 0">Nothing yet.</p>}
  </section>
</Base>
